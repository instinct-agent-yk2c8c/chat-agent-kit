# Copy to .env, fill in what you use, and `source .env` (or use direnv).
# NEVER commit your real .env - it is gitignored on purpose.

# --- Which agent / channel / provider ---
CHAT_AGENT_CHANNEL=cli            # cli | imessage | whatsapp
CHAT_AGENT_AGENT=simple           # simple | echo | command
CHAT_AGENT_PROVIDER=openai        # openai | anthropic | openrouter | gemini | github | ollama | lmstudio
CHAT_AGENT_RESPOND_TO=+15551234567   # REQUIRED for imessage/whatsapp: who may get replies

# --- Provider credentials (set the one you use) ---
# OpenAI: https://platform.openai.com/api-keys (billed separately from ChatGPT Plus)
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com (billed separately from Claude Pro/Max)
ANTHROPIC_API_KEY=
# Or set these explicitly for any OpenAI-compatible endpoint:
# CHAT_AGENT_API_KEY=
# CHAT_AGENT_BASE_URL=
# CHAT_AGENT_MODEL=

# --- WhatsApp Cloud API (only for the whatsapp channel) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=make-up-a-long-random-string
WHATSAPP_APP_SECRET=

# --- Safety ---
# Dry-run is the default. Set to 0 (or pass --send) only when ready.
CHAT_AGENT_DRY_RUN=1
